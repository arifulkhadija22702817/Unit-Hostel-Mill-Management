        "attendanceData": { "type": "object" },
        "mealOffDays": { "type": "array" },
        "fineEnabled": { "type": "boolean" },
        "attStartDate": { "type": "string" },
        "attEndDate": { "type": "string" },
        "guestRate": { "type": "number" },
        "guestDateList": { "type": "array" },
        "guestData": { "type": "object" },
        "depositData": { "type": "object" },
        "bazarData": { "type": "array" },
        "bazarStartDate": { "type": "string" },
        "bazarEndDate": { "type": "string" },
        "historyList": { "type": "array" },
        "adminPin": { "type": "string" },
        "editorPin": { "type": "string" },
        "activeEditors": { "type": "array" },
        "lastUpdated": { "type": "string" }
